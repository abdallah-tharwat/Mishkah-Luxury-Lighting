    <!-- JavaScript Application Logic -->
    <script>
        const STORAGE_KEY = 'mishkah_products_data';
        const ADMIN_PIN = '1234'; // الرقم السري للدخول للوحة التحكم - يمكنك تغييره هنا

        let products = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
        let cart = [];
        let uploadedBase64 = '';
        let logoClickCount = 0;
        let logoClickTimer;

        // DOM Elements
        const productsGrid = document.getElementById('productsGrid');
        const searchInput = document.getElementById('searchInput');
        const cartBadge = document.getElementById('cartBadge');
        const cartDrawer = document.getElementById('cartDrawer');
        const cartDrawerBtn = document.getElementById('cartDrawerBtn');
        const closeCartBtn = document.getElementById('closeCartBtn');
        const cartItemsList = document.getElementById('cartItemsList');
        const cartTotal = document.getElementById('cartTotal');
        const cartDrawerCount = document.getElementById('cartDrawerCount');

        window.onload = function() {
            renderProducts(products);
            setupEventListeners();
            updateAdminProductList();
        };

        // Triple Click on Brand Logo to Trigger Admin Authentication
        function handleLogoClick() {
            logoClickCount++;
            clearTimeout(logoClickTimer);
            if (logoClickCount === 3) {
                logoClickCount = 0;
                verifyAndOpenAdmin();
            } else {
                logoClickTimer = setTimeout(() => { logoClickCount = 0; }, 1000);
            }
        }

        // Verify PIN Code
        function verifyAndOpenAdmin() {
            const enteredPin = prompt("الرجاء إدخال الرقم السري للوحة تحكم إدارة مشكاة:");
            if (enteredPin === ADMIN_PIN) {
                openAdminModal();
            } else if (enteredPin !== null) {
                alert("الرقم السري غير صحيح!");
            }
        }

        // Keyboard Shortcut: Ctrl + Shift + A
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.shiftKey && e.key === 'A') {
                e.preventDefault();
                verifyAndOpenAdmin();
            }
        });

        // Render Product Cards
        function renderProducts(items) {
            if (!items || items.length === 0) {
                productsGrid.innerHTML = '';
                document.getElementById('emptyState').classList.remove('hidden');
                return;
            }
            document.getElementById('emptyState').classList.add('hidden');

            productsGrid.innerHTML = items.map(product => {
                return `
                    <div class="bg-darkcard border border-darkborder hover:border-gold-400/50 rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-lg flex flex-col group relative">
                        <div class="relative h-64 overflow-hidden bg-black/40">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            ${product.badge ? `<span class="absolute top-3 right-3 bg-gold-500 text-black font-extrabold text-[10px] px-2.5 py-1 rounded-full shadow-md">${product.badge}</span>` : ''}
                            
                            <button onclick="openQuickView(${product.id})" class="absolute bottom-3 left-1/2 -translate-x-1/2 bg-darkbg/90 hover:bg-gold-500 text-slate-200 hover:text-black border border-gold-400/40 text-xs font-bold py-2 px-4 rounded-xl opacity-0 group-hover:opacity-100 transition-all duration-300 whitespace-nowrap shadow-xl">
                                <i class="fa-solid fa-eye ml-1"></i> معاينة التفاصيل
                            </button>
                        </div>

                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <span class="text-xs text-gold-400 font-bold block mb-1">${product.category}</span>
                                <h3 class="font-bold text-slate-100 text-base font-cairo line-clamp-2 cursor-pointer mb-3" onclick="openQuickView(${product.id})">
                                    ${product.name}
                                </h3>
                            </div>

                            <div>
                                <div class="text-xl font-black text-gold-400 font-cairo mb-4">${Number(product.price).toLocaleString()} ج.م</div>
                                <div class="grid grid-cols-2 gap-2">
                                    <button onclick="addToCart(${product.id})" class="bg-darkbg hover:bg-gold-500 text-gold-300 hover:text-black border border-gold-400/40 font-bold py-2 px-3 rounded-xl transition-all text-xs flex items-center justify-center gap-1">
                                        <i class="fa-solid fa-cart-plus"></i>
                                        <span>السلة</span>
                                    </button>
                                    <a href="https://wa.me/201095942001?text=${encodeURIComponent('السلام عليكم، أود الاستفسار عن نجفة: ' + product.name)}" target="_blank" class="bg-emerald-600/20 hover:bg-emerald-600 text-emerald-400 hover:text-white border border-emerald-500/40 font-bold py-2 px-3 rounded-xl transition-all text-xs flex items-center justify-center gap-1">
                                        <i class="fa-brands fa-whatsapp"></i>
                                        <span>طلب</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Filter Products
        function filterCategory(category) {
            document.querySelectorAll('.cat-tab').forEach(tab => {
                if (tab.innerText.includes(category) || (category === 'الكل' && tab.innerText === 'الكل')) {
                    tab.classList.add('bg-gold-500', 'text-black');
                    tab.classList.remove('text-gray-300');
                } else {
                    tab.classList.remove('bg-gold-500', 'text-black');
                    tab.classList.add('text-gray-300');
                }
            });

            if (category === 'الكل') {
                renderProducts(products);
            } else {
                const filtered = products.filter(p => p.category === category);
                renderProducts(filtered);
            }
        }

        // Handle Image File Preview
        function previewImageFile(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    uploadedBase64 = event.target.result;
                    document.getElementById('imgPreview').src = uploadedBase64;
                    document.getElementById('imgPreviewBox').classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        }

        // Add Product Submit
        function handleAddProduct(e) {
            e.preventDefault();
            const name = document.getElementById('pName').value.trim();
            const price = document.getElementById('pPrice').value;
            const category = document.getElementById('pCategory').value;
            const urlImg = document.getElementById('pUrl').value.trim();
            const dims = document.getElementById('pDims').value.trim();
            const badge = document.getElementById('pBadge').value.trim();
            const desc = document.getElementById('pDesc').value.trim();

            const finalImg = uploadedBase64 || urlImg || 'https://via.placeholder.com/600x600?text=Mishkah+Lighting';

            const newProduct = {
                id: Date.now(),
                name,
                price: Number(price),
                category,
                image: finalImg,
                dimensions: dims || 'قياسي',
                badge: badge || '',
                desc: desc || 'نجفة مميزة من متجر مشكاة للإضاءة.'
            };

            products.unshift(newProduct);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(products));

            // Reset form
            document.getElementById('addProductForm').reset();
            document.getElementById('imgPreviewBox').classList.add('hidden');
            uploadedBase64 = '';

            renderProducts(products);
            updateAdminProductList();
            alert('تم حفظ المنتج بنجاح ونشره في الواجهة!');
        }

        // Update Admin List
        function updateAdminProductList() {
            document.getElementById('adminProdCount').innerText = products.length;
            const list = document.getElementById('adminProdList');
            if (products.length === 0) {
                list.innerHTML = '<p class="text-xs text-gray-500 text-center py-2">لا توجد منتجات مضافة بعد.</p>';
                return;
            }
            list.innerHTML = products.map(p => `
                <div class="flex items-center justify-between bg-darkbg p-2 rounded-lg border border-darkborder text-xs">
                    <div class="flex items-center gap-2 overflow-hidden">
                        <img src="${p.image}" class="w-8 h-8 object-cover rounded">
                        <span class="text-slate-200 truncate max-w-[200px]">${p.name}</span>
                    </div>
                    <button onclick="deleteProduct(${p.id})" class="text-rose-500 hover:text-rose-400 p-1">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            `).join('');
        }

        function deleteProduct(id) {
            if (confirm('هل أنت تأكد من حذف هذا المنتج؟')) {
                products = products.filter(p => p.id !== id);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(products));
                renderProducts(products);
                updateAdminProductList();
            }
        }

        // Admin Modal Toggles
        function openAdminModal() {
            document.getElementById('adminModal').classList.add('modal-active');
        }
        function closeAdminModal() {
            document.getElementById('adminModal').classList.remove('modal-active');
        }

        // Event Listeners Setup
        function setupEventListeners() {
            searchInput.addEventListener('input', (e) => {
                const query = e.target.value.trim().toLowerCase();
                if (!query) {
                    renderProducts(products);
                    return;
                }
                const matched = products.filter(p => p.name.toLowerCase().includes(query) || p.category.includes(query));
                renderProducts(matched);
            });

            cartDrawerBtn.addEventListener('click', () => cartDrawer.classList.remove('-translate-x-full'));
            closeCartBtn.addEventListener('click', () => cartDrawer.classList.add('-translate-x-full'));
            document.getElementById('mobileMenuBtn').addEventListener('click', () => {
                document.getElementById('mobileMenu').classList.toggle('hidden');
            });
        }

        // Cart Actions
        function addToCart(id) {
            const product = products.find(p => p.id === id);
            const existing = cart.find(item => item.id === id);
            if (existing) {
                existing.qty++;
            } else {
                cart.push({ ...product, qty: 1 });
            }
            updateCartDrawer();
            cartDrawer.classList.remove('-translate-x-full');
        }

        function updateCartDrawer() {
            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            cartBadge.innerText = totalCount;
            cartDrawerCount.innerText = totalCount;

            if (cart.length === 0) {
                cartItemsList.innerHTML = '<p class="text-xs text-gray-500 text-center py-8">السلة فارغة حالياً</p>';
                cartTotal.innerText = '0 ج.م';
                return;
            }

            let subtotal = 0;
            let orderSummary = 'طلب جديد من متجر مشكاة:\n';

            cartItemsList.innerHTML = cart.map(item => {
                subtotal += item.price * item.qty;
                orderSummary += `- ${item.name} (${item.qty} قطعة) بسعر ${item.price * item.qty} ج.م\n`;

                return `
                    <div class="flex items-center gap-3 bg-darkbg p-3 rounded-xl border border-darkborder relative">
                        <img src="${item.image}" class="w-14 h-14 object-cover rounded-lg">
                        <div class="flex-1">
                            <h4 class="text-xs font-bold text-slate-200 line-clamp-1">${item.name}</h4>
                            <div class="text-xs text-gold-400 font-bold font-cairo mt-1">${(item.price * item.qty).toLocaleString()} ج.م</div>
                        </div>
                        <button onclick="removeFromCart(${item.id})" class="text-gray-500 hover:text-rose-500 text-sm p-1">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                `;
            }).join('');

            cartTotal.innerText = `${subtotal.toLocaleString()} ج.م`;
            orderSummary += `\nالإجمالي النهائي: ${subtotal.toLocaleString()} ج.م`;
            
            document.getElementById('whatsappOrderBtn').href = `https://wa.me/201095942001?text=${encodeURIComponent(orderSummary)}`;
        }

        function removeFromCart(id) {
            cart = cart.filter(i => i.id !== id);
            updateCartDrawer();
        }

        // Quick View Modal
        function openQuickView(id) {
            const product = products.find(p => p.id === id);
            const modalContent = document.getElementById('modalContent');

            modalContent.innerHTML = `
                <div class="h-64 md:h-full bg-black">
                    <img src="${product.image}" class="w-full h-full object-cover">
                </div>
                <div class="p-6 flex flex-col justify-between">
                    <div>
                        <span class="text-xs text-gold-400 font-bold block mb-1">${product.category}</span>
                        <h3 class="text-xl font-bold font-cairo text-white mb-2">${product.name}</h3>
                        <p class="text-xs text-gray-300 leading-relaxed mb-4">${product.desc}</p>
                        <div class="bg-darkbg p-3 rounded-xl border border-darkborder text-xs text-gray-300 mb-6">
                            <strong>الأبعاد:</strong> ${product.dimensions || 'قياسي'}
                        </div>
                    </div>
                    <div>
                        <div class="text-2xl font-black text-gold-400 font-cairo mb-4">${Number(product.price).toLocaleString()} ج.م</div>
                        <button onclick="addToCart(${product.id}); closeQuickView();" class="w-full gold-btn text-black font-extrabold py-3 rounded-xl flex items-center justify-center gap-2 text-sm shadow-lg">
                            <i class="fa-solid fa-cart-plus"></i>
                            <span>إضافة لسلة التسوق</span>
                        </button>
                    </div>
                </div>
            `;
            document.getElementById('quickViewModal').classList.add('modal-active');
        }

        function closeQuickView() {
            document.getElementById('quickViewModal').classList.remove('modal-active');
        }
    </script>
</body>
</html>
